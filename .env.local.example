# Copy to .env.local (which is gitignored) and fill in your values.
# Used by release.sh for Developer ID signing + notarization.

# Your Developer ID Application identity. Find with:
#   security find-identity -v -p codesigning
SNIPPY_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Name of the keychain profile created via:
#   xcrun notarytool store-credentials snippy-notary \
#     --apple-id "you@example.com" \
#     --team-id "TEAMID" \
#     --key /path/to/AuthKey_XXXXXX.p8 \
#     --key-id "XXXXXX" \
#     --issuer "your-issuer-uuid"
SNIPPY_NOTARY_PROFILE="snippy-notary"

# Set to 1 to sign but skip notarization (useful while you're iterating on the
# signing config without burning minutes on the notary service).
# SNIPPY_SKIP_NOTARIZE=0
